{
  "name": "hanif-mobile-care-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Hanif Mobile Care Solutions full-stack monorepo with a Next.js client and MERN server.",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix client run start",
    "lint": "npm --prefix client run lint",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "test:server": "npm --prefix server run test",
    "lint:server": "npm --prefix server run lint",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
